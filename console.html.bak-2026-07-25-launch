    `<div class="ctr ${x.up?"":"down"}" title="${esc(x.name)} — ${esc(x.status)}">
      ${stDot(x.up?"ok":"bad")}<span>${esc(x.name)}</span></div>`).join("");
  return `<div class="node"><h2>${esc(s.hostname)} <span class="role">Start9 · self-hosted</span>
    <span class="up">up ${esc(s.uptime)}</span></h2>
    ${row("CPU",s.cpu_pct||0,`${s.cpu_pct??"?"}% · ${esc(s.load)}`)}
    ${s.power_w!=null?row("Power",pwrPct,`${s.power_w} W · ${esc(pwrDetail)}`):""}
    ${row("Mem",m.pct||0,`${m.used_gb??"?"} / ${m.total_gb??"?"} G (${m.pct??"?"}%)`)}
    ${row("Swap",(s.swap||{}).pct||0,`${(s.swap||{}).used_gb??"?"} / ${(s.swap||{}).total_gb??"?"} G`)}
    ${row("Data",dd.pct||0,`${Math.round(dd.used_gb||0)} G · ${dd.free_tb??"?"} TB free`)}
    ${row("Root",dr.pct||0,`${dr.used_gb??"?"}/${dr.total_gb??"?"} G overlay`)}
    <div class="kv"><span class="k">startd</span>
      <span class="v ${s.startd==="active"?"ok":"bad"}">${esc(s.startd)}</span></div>
    <div class="kv"><span class="k">Tier-3 backup marker</span>
      <span class="v">${esc(bk.ago||"unknown")}</span></div>
    <div class="kv"><span class="k">CPU package</span>
      <span class="v ${(s.temp_c||0)>=90?"warn":""}">${esc(s.temp_c??"?")}°C
        <span class="faint">${esc(s.temp_source||"")}</span></span></div>
    <div class="subhead">Containers<span class="cnt">${c.running??"?"} / ${c.total??"?"} up</span></div>
    <div class="ctr-grid">${ctrs||'<div class="empty">none</div>'}</div></div>`;
}
function renderFleet(d){
  $("v-fleet").innerHTML=node1Html(d.node1||{})+node2Html(d.node2)+piHtml(d.pi)+start9Html(d.start9);
  if(TAB==="fleet")drawAll();
}

/* ---------------------------- services tab ---------------------------- */
let SVC_GROUP="all";
function svcGroup(el){
  document.querySelectorAll("#v-services .pill").forEach(p=>p.classList.toggle("on",p===el));
  SVC_GROUP=el.dataset.g;renderServices();
}
function renderServices(){
  const bundle=DATA.services||{};
  const list=bundle.services||[];
  const q=($("svc-q").value||"").toLowerCase();
  const op=bundle.active_operation;
  const up=list.filter(s=>s.active).length;
  const waste=(bundle.waste_ids||[]).length;
  $("b-services").hidden=!waste;
  if(waste){$("b-services").className="badge warn";$("b-services").textContent=waste;}
  $("svc-op").textContent=op&&op.status==="running"?`⏳ ${op.type} ${op.key}: ${op.message||"running…"}`
    :op&&op.status==="failed"?`✕ ${op.type} ${op.key} failed`
    :waste?`⚡ ${waste} running with no recent use`:`${up}/${list.length} up`;
  const busy=!!(op&&op.status==="running");
  const shown=list.filter(s=>(SVC_GROUP==="all"||s.group===SVC_GROUP)
    &&(!q||(s.label+" "+s.detail+" "+s.id).toLowerCase().includes(q)));
  $("services").innerHTML=shown.map(s=>{
    const st=s.active?"ok":(s.state==="failed"||s.unit_missing?"bad":"stale");
    const canStop=!s.no_stop&&s.active&&!s.unit_missing, canStart=!s.active&&!s.unit_missing;
    let sel="";
    if(s.id==="node2-deep"&&s.models&&s.models.length){
      const cur=s.model_key||s.default_model||s.models[0];
      sel=`<select id="svc-model-${esc(s.id)}" ${busy?"disabled":""}>${s.models.map(m=>
        `<option value="${esc(m)}" ${m===cur?"selected":""}>${esc(m)}</option>`).join("")}</select>`;
    }
    const idle=s.idle||"unknown";
    const used=s.active?`last use ${esc(s.last_used_ago||"?")}${idle==="waste"?" · STOP?":idle==="idle"?" · idle":""}`
      :(s.unit_missing?"no unit":"stopped");
    const extra=s.serving?esc(s.serving):esc((s.extra||"").replace(/^up · ok$/,"up"));
    return `<div class="svc-card ${idle==="waste"||idle==="idle"?idle:""}" title="${esc(s.hint||s.detail||"")}">
      <div class="name">${stDot(st)}${esc(s.label)}</div>
      <div class="meta">${esc(s.detail)}${extra?` · ${extra}`:""}</div>
      <div class="used ${esc(idle)}">${used}</div>
      <div class="acts">${sel}
        <button class="btn go" ${canStart&&!busy?"":"disabled"} onclick="svcAction('${esc(s.id)}','start')">Start</button>
        <button class="btn stop" ${canStop&&!busy?"":"disabled"} onclick="svcAction('${esc(s.id)}','stop')">Stop</button>
      </div></div>`;
  }).join("")||`<div class="empty">no services match</div>`;
}
async function svcAction(id,action){
  if(action==="stop"){
    const critical=["llama-miaai35","hermes-orchestrator"];
    if(critical.includes(id)&&!confirm(`Stop ${id}? Hermes / agents may fail until it is back.`))return;
  }
  let model=null;
  if(id==="node2-deep"&&action==="start"){const sel=$("svc-model-node2-deep");model=sel?sel.value:null;}
  try{
    $("err").textContent=`${action} ${id}…`;
    const r=await fetch("/api/services/"+encodeURIComponent(id),{method:"POST",
      headers:{"Content-Type":"application/json"},body:JSON.stringify({action,model})});
    const d=await r.json();
    if(!d.ok){$("err").textContent=d.error||"action failed";return;}
    $("err").textContent=d.operation?`queued: ${d.operation.message}`:(d.message||"ok");
    for(let i=0;i<6;i++){
      await new Promise(res=>setTimeout(res,i===0?800:2000));
      DATA.services=await(await fetch("/api/services",{cache:"no-store"})).json();
      renderServices();
    }
    await refresh();
  }catch(e){$("err").textContent="service action failed: "+e.message;}
}

/* ---------------------------- automation tab ---------------------------- */
let AUTO_LAYER="all";
function autoLayer(el){
  document.querySelectorAll("#v-automation .pill").forEach(p=>p.classList.toggle("on",p===el));
  AUTO_LAYER=el.dataset.l;renderAutomation();
}
function renderAutomation(){
  const auto=DATA.automation||{};
  const jobs=auto.jobs||[];
  const q=($("auto-q").value||"").toLowerCase();
  const c=auto.counts||{};
  $("auto-summary").textContent=
    `${c.hermes??0} hermes · ${c.crontab??0} crontab · ${c.timer??0} timers · ${c.paused??0} paused`;
  const order={fail:0,warn:1,unknown:2,running:2,ok:3,paused:9};
  const sorted=[...jobs].sort((a,b)=>
    (order[a.state]??5)-(order[b.state]??5)||(a.next_ts||9e12)-(b.next_ts||9e12));
  const shown=sorted.filter(j=>{
    if(AUTO_LAYER==="problem"&&j.state!=="fail"&&j.state!=="paused")return false;
    if(AUTO_LAYER!=="all"&&AUTO_LAYER!=="problem"&&j.layer!==AUTO_LAYER)return false;
    return !q||(j.name+" "+j.detail+" "+j.schedule+" "+j.where).toLowerCase().includes(q);
  });
  $("jobs").innerHTML=`<table><thead><tr>
    <th style="width:22px"></th><th>Job</th><th>Layer</th><th>Schedule</th>
    <th>Next run</th><th>Last run</th></tr></thead><tbody>
    ${shown.map(j=>`<tr>
      <td>${stDot(j.state==="ok"?"ok":j.state==="fail"?"bad":j.state==="paused"?"stale":"warn")}</td>
      <td><div class="jname" title="${esc(j.name)}">${esc(j.name)}</div>
          <div class="jdetail" title="${esc(j.detail)}">${esc(j.where)} · ${esc(j.detail)}${
            j.error?` · <span class="bad">${esc(j.error)}</span>`:""}</div></td>
      <td><span class="lay ${esc(j.layer)}">${esc(j.layer)}</span></td>
      <td class="num faint">${esc(j.schedule)}</td>
      <td class="num">${esc(j.next_in)}</td>
      <td class="num faint">${esc(j.last_ago)}</td></tr>`).join("")
    ||`<tr><td colspan="6" class="empty">no jobs match</td></tr>`}
    </tbody></table>`;
}

/* ---------------------------- backups tab ---------------------------- */
function renderBackups(){
  const bk=DATA.backups||{};
  const c=bk.counts||{};
  $("bk-sub").textContent=`${c.ok??0} healthy · ${c.warn??0} warning · ${c.fail??0} failed`;
  $("backups").innerHTML=(bk.entries||[]).map(e=>`
    <div class="bk ${e.state==="ok"?"":e.state}">
      <div class="h">${stDot(e.state==="ok"?"ok":e.state==="fail"?"bad":e.state==="warn"?"warn":"stale")}
        <b>${esc(e.label)}</b><span class="tier">tier ${esc(e.tier)}</span>
        <span class="age ${e.state==="ok"?"ok":e.state==="fail"?"bad":"warn"}">${esc(e.ago)}</span></div>
      <div class="d" title="${esc(e.detail)}">${esc(e.detail)}</div>
      ${e.extra?`<div class="t">${esc(e.extra)}</div>`:""}
      ${e.note?`<div class="n">⚠ ${esc(e.note)}</div>`:""}
      <div class="t">expected every ${esc(e.cadence_h)}h${e.target?` · ${esc(e.target)}`:""}</div>
    </div>`).join("")||`<div class="empty">no backup data yet</div>`;
}

/* ---------------------------- launcher tab ---------------------------- */
function renderLauncher(){
  const links=DATA.links||{};
  const q=($("link-q").value||"").toLowerCase();
  const c=links.counts||{};
  $("link-cnt").textContent=`${c.up??0} of ${c.total??0} reachable`;
  $("launcher").innerHTML=(links.groups||[]).map(g=>{
    const shown=(g.links||[]).filter(l=>!q||(l.label+" "+(l.detail||"")).toLowerCase().includes(q));
    if(!shown.length)return "";
    return `<div class="lgroup"><h4>${esc(g.label)}
      <span class="cnt">${shown.length}${g.note?" · "+esc(g.note):""}</span></h4>
      <div class="ltiles">${shown.map(l=>{
        const url=l.url||`http://${location.hostname}:${l.port}${l.path||"/"}`;
        const stopped=l.status==="down"&&g.kind==="local";
        const attrs=stopped
          ? `href="#services" onclick="openStopped('${esc(l.label)}');return false;"
             title="stopped — click to start it on the Services tab"`
          : `href="${esc(url)}" target="_blank" rel="noopener" title="${esc(url)}"`;
        return `<a class="ltile ${l.status==="up"?"":"down"}" ${attrs}>
          <b>${stDot(l.status==="up"?"ok":l.status==="down"?"bad":"stale")}${esc(l.label)}</b>
          <span>${stopped?"stopped · start it →":esc(l.detail||url.replace(/^https?:\/\//,""))}</span></a>`;
      }).join("")}</div></div>`;
  }).join("")||`<div class="empty">no links yet</div>`;
}

function openStopped(label){
  switchTab("services");
  const box=$("svc-q");
  if(box){box.value=label;renderServices();}
}

/* ---------------------------- actions ---------------------------- */
async function runAction(id){
  const btn=$("act-"+id);
  if(btn){btn.disabled=true;btn.textContent="…";}
  try{
    const r=await fetch("/api/actions/"+encodeURIComponent(id),{method:"POST"});
    const d=await r.json();
    if(!d.ok){$("err").textContent=d.error||"action failed";return;}
    const runId=d.run.id;
    for(let i=0;i<40;i++){
      await new Promise(res=>setTimeout(res,i<3?600:1500));
      const rr=await fetch("/api/actions/runs/"+runId,{cache:"no-store"});
      if(!rr.ok)break;
      const run=(await rr.json()).run;
      const out=$("out-"+id);
      if(out)out.textContent=`${run.status}${run.took_s?" · "+run.took_s+"s":""}\n${run.output||""}`.slice(0,2000);
      if(run.status!=="running"){
        DATA.actions=(await(await fetch("/api/actions")).json()).actions;
        renderActions(DATA.actions);
        const o2=$("out-"+id);
        if(o2)o2.textContent=`${run.status} · ${run.took_s}s\n${(run.output||"").slice(-1200)}`;
        break;
      }
    }
  }catch(e){$("err").textContent="action failed: "+e.message;}
  finally{if($("act-"+id)){$("act-"+id).disabled=false;$("act-"+id).textContent="Run";}}
}

/* ---------------------------- todos ---------------------------- */
async function todoAction(action,id){
  try{
    const r=await fetch("/api/todos",{method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({action,id})});
    renderTodos((await r.json()).todos||[]);
  }catch(e){$("err").textContent="todo failed: "+e.message;}
}
async function addTodo(){
  const el=$("todo-in"),text=el.value.trim();
  if(!text)return;
  el.value="";
  try{
    const r=await fetch("/api/todos",{method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({action:"add",text,tag:$("todo-tag").value})});
    renderTodos((await r.json()).todos||[]);
  }catch(e){$("err").textContent="todo failed: "+e.message;}
}
$("todo-in").addEventListener("keydown",e=>{if(e.key==="Enter")addTodo();});

/* ---------------------------- main refresh ---------------------------- */
async function refresh(){
  try{
    const d=await(await fetch("/api/overview",{cache:"no-store"})).json();
    DATA=d;
    const hosts=fleetHosts(d);
    renderChips(hosts);
    renderHostTiles(hosts);
    renderAlerts(d.alerts||[]);
    renderTodos(d.todos||[]);
    renderActions(d.actions||[]);
    renderUpcoming(d.automation||{});
    renderBackupMini(d.backups||{});
    renderProjects(d.projects||[]);
    renderFleet(d);
    renderServices();
    renderAutomation();
    renderBackups();
    renderLauncher();
    const down=hosts.filter(h=>h.state==="bad").length;
    $("b-fleet").hidden=!down;
    if(down){$("b-fleet").className="badge";$("b-fleet").textContent=down;}
    $("stamp").textContent="updated "+new Date().toLocaleTimeString();
    $("err").textContent="";
  }catch(e){$("err").textContent="refresh failed: "+e.message;}
}
const tick=()=>$("clock").textContent=new Date().toLocaleTimeString();
tick();setInterval(tick,1000);
switchTab(TAB);
refresh();setInterval(refresh,10000);
window.addEventListener("hashchange",()=>switchTab((location.hash||"#overview").slice(1)));
window.addEventListener("resize",()=>{if(TAB==="fleet")drawAll();});
</script>
