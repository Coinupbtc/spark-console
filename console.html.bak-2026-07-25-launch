<body>

<header>
  <h1>⚡ Spark Console</h1>
  <div class="fleet-chips" id="chips"></div>
  <span class="err" id="err"></span>
  <div class="theme-dock" aria-label="Visual theme">
    <input id="theme-dark" name="theme" type="radio" checked>
    <label for="theme-dark" title="Dark mode">Dark</label>
    <input id="theme-ocean" name="theme" type="radio">
    <label for="theme-ocean" title="Ocean bubbles mode">Ocean</label>
    <input id="theme-tokyo" name="theme" type="radio">
    <label for="theme-tokyo" title="Tokyo anime mode">Tokyo</label>
  </div>
  <span class="stamp" id="stamp"></span>
  <span class="clock" id="clock"></span>
</header>

<nav id="tabs">
  <div class="tab on" data-tab="overview"><kbd>1</kbd>Overview <span class="badge" id="b-overview" hidden></span></div>
  <div class="tab" data-tab="fleet"><kbd>2</kbd>Fleet <span class="badge" id="b-fleet" hidden></span></div>
  <div class="tab" data-tab="services"><kbd>3</kbd>Services <span class="badge" id="b-services" hidden></span></div>
  <div class="tab" data-tab="automation"><kbd>4</kbd>Automation <span class="badge" id="b-automation" hidden></span></div>
  <div class="tab" data-tab="backups"><kbd>5</kbd>Backups <span class="badge" id="b-backups" hidden></span></div>
  <div class="tab" data-tab="launcher"><kbd>6</kbd>Launcher</div>
  <div class="spacer"></div>
  <span class="hint">1–6 tabs · / search · r refresh</span>
</nav>

<!-- ================= OVERVIEW ================= -->
<section class="view on" id="v-overview">
  <div class="hostrow" id="hostrow"></div>
  <div class="ov-mid">
    <div class="panel"><h3>Needs attention <span class="cnt" id="alert-cnt"></span></h3>
      <div class="scroll" id="alerts"></div></div>
    <div class="panel"><h3>Todo · Home <span class="cnt" id="todo-cnt"></span></h3>
      <div class="scroll" id="todos"></div>
      <div class="todo-add">
        <input type="text" id="todo-in" placeholder="add item…">
        <select id="todo-tag"><option>home</option><option>stack</option><option>models</option>
          <option>hermes</option><option>backups</option><option>fleet</option></select>
        <button onclick="addTodo()">+</button></div></div>
    <div class="panel"><h3>Quick actions</h3>
      <div class="scroll" id="actions"></div></div>
  </div>
  <div class="ov-bot">
    <div class="panel"><h3>Next automation <span class="cnt" id="auto-cnt"></span></h3>
      <div class="scroll" id="upcoming"></div></div>
    <div class="panel"><h3>Backups <span class="cnt" id="bk-cnt"></span></h3>
      <div class="scroll" id="bk-mini"></div></div>
    <div class="panel"><h3>Projects <span class="cnt" id="proj-cnt"></span></h3>
      <div class="proj-grid" id="projects"></div></div>
  </div>
</section>

<!-- ================= FLEET ================= -->
<section class="view" id="v-fleet"></section>

<!-- ================= SERVICES ================= -->
<section class="view" id="v-services">
  <div class="panel" style="padding:10px 12px">
    <div class="toolbar">
      <input type="text" id="svc-q" placeholder="filter services…" oninput="renderServices()">
      <span class="pill on" data-g="all" onclick="svcGroup(this)">All</span>
      <span class="pill" data-g="inference" onclick="svcGroup(this)">Inference</span>
      <span class="pill" data-g="hermes" onclick="svcGroup(this)">Hermes</span>
      <span class="pill" data-g="apps" onclick="svcGroup(this)">Apps</span>
      <span class="pill" data-g="meta" onclick="svcGroup(this)">Meta</span>
      <span class="svc-op" id="svc-op"></span>
    </div>
  </div>
  <div class="svc-grid" id="services"></div>
</section>

<!-- ================= AUTOMATION ================= -->
<section class="view" id="v-automation">
  <div class="panel" style="padding:10px 12px">
    <div class="toolbar">
      <input type="text" id="auto-q" placeholder="filter jobs…" oninput="renderAutomation()">
      <span class="pill on" data-l="all" onclick="autoLayer(this)">All layers</span>
      <span class="pill" data-l="hermes" onclick="autoLayer(this)">Hermes cron</span>
      <span class="pill" data-l="crontab" onclick="autoLayer(this)">OS crontab</span>
      <span class="pill" data-l="timer" onclick="autoLayer(this)">systemd timers</span>
      <span class="pill" data-l="problem" onclick="autoLayer(this)">Problems</span>
      <span class="cnt faint num" id="auto-summary" style="font-size:11px"></span>
    </div>
  </div>
  <div class="panel jobs" id="jobs"></div>
</section>

<!-- ================= BACKUPS ================= -->
<section class="view" id="v-backups">
  <div class="panel" style="padding:10px 12px">
    <div class="toolbar"><b style="font-size:12.5px" id="bk-head">Backup tiers</b>
      <span class="cnt faint" id="bk-sub" style="font-size:11.5px"></span></div>
  </div>
  <div class="bk-grid" id="backups"></div>
</section>

<!-- ================= LAUNCHER ================= -->
<section class="view" id="v-launcher">
  <div class="panel" style="padding:10px 12px">
    <div class="toolbar">
      <input type="text" id="link-q" placeholder="filter apps…" oninput="renderLauncher()">
      <span class="cnt faint" id="link-cnt" style="font-size:11.5px"></span>
      <span class="faint" style="font-size:11px">opens in a new tab</span>
    </div>
  </div>
  <div class="launch-wrap" id="launcher"></div>
</section>

<script>
const $=id=>document.getElementById(id);
const esc=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const cls=p=>p>=90?"b":p>=70?"w":"";
const stDot=s=>`<span class="dot ${s==='ok'?'ok':s==='warn'?'warn':s==='stale'||s==='unknown'?'stale':'bad'}"></span>`;
const pct=(u,t)=>t?Math.round(u/t*100):0;
const row=(l,p,v)=>`<div class="brow"><label>${l}</label><div class="bar"><i class="${cls(p)}" style="width:${Math.min(p||0,100)}%"></i></div><div class="v">${v}</div></div>`;
let DATA={};

/* ---------------------------- tabs ---------------------------- */
let TAB=(location.hash||"#overview").slice(1);
function switchTab(name){
  if(!$("v-"+name))name="overview";
  TAB=name;location.hash="#"+name;
  document.querySelectorAll(".view").forEach(v=>v.classList.toggle("on",v.id==="v-"+name));
  document.querySelectorAll(".tab").forEach(t=>t.classList.toggle("on",t.dataset.tab===name));
  if(name==="fleet")requestAnimationFrame(drawAll);
}
document.querySelectorAll(".tab").forEach(t=>t.onclick=()=>switchTab(t.dataset.tab));
document.addEventListener("keydown",e=>{
  if(/^(INPUT|SELECT|TEXTAREA)$/.test(document.activeElement.tagName))return;
  const map={"1":"overview","2":"fleet","3":"services","4":"automation","5":"backups","6":"launcher"};
  if(map[e.key]){switchTab(map[e.key]);return;}
  if(e.key==="/"){e.preventDefault();
    const box={services:"svc-q",automation:"auto-q",launcher:"link-q"}[TAB];
    if(box)$(box).focus();return;}
  if(e.key==="r"){refresh();}
});

/* ---------------------------- charts (node1/node2) ---------------------------- */
const cssVar=(n,f)=>getComputedStyle(document.body).getPropertyValue(n).trim()||f;
const chartPaint=()=>({
  a:cssVar("--chart-a","#3d8ee8"), b:cssVar("--chart-b","#e8654a"),
  grid:cssVar("--chart-grid","rgba(139,152,165,.14)"), cursor:cssVar("--chart-cursor","rgba(233,238,244,.45)"),
  glowA:cssVar("--chart-glow-a","rgba(61,142,232,.45)"), glowB:cssVar("--chart-glow-b","rgba(232,101,74,.38)"),
  barA:cssVar("--chart-bar-a","rgba(61,142,232,.28)"), barB:cssVar("--chart-bar-b","rgba(232,101,74,.25)"),
  panel:cssVar("--panel","#151b23")});
const CHARTS=[
  {key:"cpu", title:"CPU · GPU",  a:{f:"cpu"}, b:{f:"gpu"},  unit:"%",  max:100},
  {key:"mem", title:"Mem · Swap", a:{f:"mem"}, b:{f:"swap"}, unit:"%",  max:100},
  // GB10 power.limit is N/A; scale to observed ~93W historical peak
  {key:"pwr", title:"GPU power",  a:{f:"pwr"}, b:null,      unit:"W",  max:100},
  {key:"net", title:"Net rx · tx",a:{f:"rx"},  b:{f:"tx"},   unit:"K/s",max:0}];
const chartsBlock=nid=>`<div class="charts">${CHARTS.map(c=>`
  <div class="chart"><h5>${c.title}<span class="cur" id="${nid}-${c.key}-cur"></span></h5>
  <canvas id="${nid}-${c.key}" data-node="${nid}" data-chart="${c.key}"></canvas></div>`).join("")}</div>`;
let sparks={node1:[],node2:[]};
const niceMax=v=>{const steps=[64,128,256,512,1024,2048,5120,10240,51200,102400,1048576];
  for(const s of steps)if(v<=s)return s;return Math.ceil(v/1048576)*1048576;};
const fmtK=v=>v>=1024?(v/1024).toFixed(v>=10240?0:1)+" M/s":Math.round(v)+" K/s";

function drawChart(cv,samples,cfg,hoverX){
  const dpr=window.devicePixelRatio||1, w=cv.clientWidth, h=cv.clientHeight;
  if(!w||!h)return;
  if(cv.width!==w*dpr||cv.height!==h*dpr){cv.width=w*dpr;cv.height=h*dpr;}
  const x=cv.getContext("2d");x.setTransform(dpr,0,0,dpr,0,0);x.clearRect(0,0,w,h);
  const paint=chartPaint();
  // Leave room for Y ticks (left) and X time labels (bottom) — without this
  // the series fills the canvas and the axes are invisible by design.
  const padL=30, padR=4, padT=3, padB=14;
  const plotW=Math.max(1,w-padL-padR), plotH=Math.max(1,h-padT-padB);
  const win=60, tmax=samples.length?samples[samples.length-1].t:0, tmin=tmax-win;
  const pts=samples.filter(s=>s.t>=tmin);
  let ymax=cfg.max;
  if(!ymax)ymax=niceMax(Math.max(64,...pts.map(p=>Math.max(p[cfg.a.f],cfg.b?p[cfg.b.f]:0))));
  const X=t=>padL+(t-tmin)/win*plotW, Y=v=>padT+plotH-Math.min(v,ymax)/ymax*plotH;
  const tickFmt=v=>cfg.unit==="%"?Math.round(v)+""
    :cfg.unit==="W"?String(Math.round(v))
    :v>=1024?(v/1024).toFixed(v>=10240?0:1)+"M":Math.round(v)+"";

  // Y grid + tick labels (0 / mid / max) — right-aligned into the left pad
  x.font="9px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace";
  const tickColor=cssVar("--dim","#8b98a5");
  for(const fr of[0,0.5,1]){
    const yy=padT+plotH*(1-fr);
    x.strokeStyle=paint.grid;x.lineWidth=1;
    x.beginPath();x.moveTo(padL,yy);x.lineTo(padL+plotW,yy);x.stroke();
    x.fillStyle=tickColor;x.textAlign="right";x.textBaseline="middle";
    x.fillText(tickFmt(ymax*fr), padL-3, yy+(fr===0? -1 : fr===1? 1 : 0));
  }
  // Tiny unit badge under the top tick so you know what the numbers mean
  x.textAlign="left";x.textBaseline="top";
  x.fillText(cfg.unit, padL+2, padT+1);

  // X ticks: window start / mid / now
  x.textAlign="center";x.textBaseline="top";
  const xTicks=[[tmin,"−60s"],[tmin+win/2,"−30s"],[tmax,"now"]];
  for(const[t,lab] of xTicks){
    const xx=X(t);
    x.strokeStyle=paint.grid;x.lineWidth=1;
    x.beginPath();x.moveTo(xx,padT+plotH);x.lineTo(xx,padT+plotH+3);x.stroke();
    x.fillStyle=tickColor;
    // Keep edge labels from clipping off the canvas
    const align=t===tmin?"left":t===tmax?"right":"center";
    x.textAlign=align;
    x.fillText(lab, xx, padT+plotH+4);
  }

  const series=(f,color,glow,alpha)=>{
    if(pts.length<2)return;
    x.beginPath();pts.forEach((p,i)=>i?x.lineTo(X(p.t),Y(p[f]||0)):x.moveTo(X(p.t),Y(p[f]||0)));
    x.lineTo(X(pts[pts.length-1].t),padT+plotH);x.lineTo(X(pts[0].t),padT+plotH);x.closePath();
    x.save();x.globalAlpha=alpha;x.fillStyle=color;x.fill();x.restore();
    x.save();x.beginPath();pts.forEach((p,i)=>i?x.lineTo(X(p.t),Y(p[f]||0)):x.moveTo(X(p.t),Y(p[f]||0)));
    x.shadowColor=glow;x.shadowBlur=10;x.strokeStyle=color;x.lineWidth=2;x.lineJoin="round";x.stroke();x.restore();};
  if(cfg.b)series(cfg.b.f,paint.b,paint.glowB,.12);
  series(cfg.a.f,paint.a,paint.glowA,.16);
  let cur=pts[pts.length-1];
  if(hoverX!=null&&pts.length){
    // Map mouse X into the plot (hover may land in the pads)
    const hx=Math.min(Math.max(hoverX,padL),padL+plotW);
    let best=pts[0];for(const p of pts)if(Math.abs(X(p.t)-hx)<Math.abs(X(best.t)-hx))best=p;
    cur=best;
    x.strokeStyle=paint.cursor;x.lineWidth=1;
    x.beginPath();x.moveTo(X(cur.t),padT);x.lineTo(X(cur.t),padT+plotH);x.stroke();
    const dots=[[cfg.a.f,paint.a,paint.glowA]];
    if(cfg.b)dots.push([cfg.b.f,paint.b,paint.glowB]);
    for(const[f,c,g]of dots){
      x.save();x.shadowColor=g;x.shadowBlur=10;x.beginPath();x.arc(X(cur.t),Y(cur[f]||0),3,0,7);
