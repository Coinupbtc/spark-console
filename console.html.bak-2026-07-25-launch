<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Spark Console</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ctext y='26' font-size='26'%3E%E2%9A%A1%3C/text%3E%3C/svg%3E">
<style>
/* ============================== theme tokens ============================== */
:root{
  --bg:#08090d; --panel:#12141c; --panel2:#191d27; --line:rgba(222,230,242,.14);
  --fg:#f4f2ea; --dim:#b4ad9e; --faint:#7e796f;
  --ok:#66d27a; --warn:#f2b84b; --bad:#ff685f; --stale:#8f928f;
  --accent:#66d9e8; --accent-hi:#f4c76a; --accent-soft:rgba(102,217,232,.14);
  --mono:'SFMono-Regular',ui-monospace,Menlo,Consolas,monospace;
  --page-bg:
    radial-gradient(circle at 15% 8%,rgba(102,217,232,.16),transparent 25%),
    radial-gradient(circle at 86% 0%,rgba(244,199,106,.14),transparent 24%),
    linear-gradient(135deg,#08090d 0%,#121018 52%,#0a0e11 100%);
  --ambient:
    linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px),
    linear-gradient(0deg,rgba(255,255,255,.025) 1px,transparent 1px);
  --ambient-size:42px 42px; --ambient-opacity:.34;
  --surface:linear-gradient(145deg,rgba(21,23,31,.95),rgba(11,13,18,.95));
  --surface2:rgba(255,255,255,.045);
  --chrome:rgba(14,16,22,.82);
  --field:#111721;
  --shadow:0 16px 34px rgba(0,0,0,.32);
  --shine:rgba(255,255,255,.07);
  --row-line:rgba(222,230,242,.1);
  --bar-track:#0b0f15;
  --bar-fill:linear-gradient(90deg,#4ad5df,var(--accent-hi));
  --chart-a:#5edcff; --chart-b:#ffcf70;
  --chart-grid:rgba(222,230,242,.14);
  --chart-cursor:rgba(244,242,234,.42);
  --chart-glow-a:rgba(102,217,232,.48); --chart-glow-b:rgba(244,199,106,.36);
  --chart-bar-a:rgba(94,220,255,.34); --chart-bar-b:rgba(255,207,112,.28);
  --chart-bg:
    radial-gradient(circle at 18% 22%,rgba(102,217,232,.12),transparent 34%),
    linear-gradient(180deg,rgba(255,255,255,.035),transparent 58%);
}
body:has(#theme-ocean:checked){
  --bg:#03171c; --panel:#072832; --panel2:#0a3740; --line:rgba(172,246,235,.2);
  --fg:#eafffa; --dim:#a6d9d1; --faint:#6e9e99;
  --ok:#7df5a7; --warn:#ffd166; --bad:#ff7b72; --stale:#85a8ac;
  --accent:#54e7d4; --accent-hi:#a8fff3; --accent-soft:rgba(84,231,212,.18);
  --page-bg:
    radial-gradient(circle at 16% 16%,rgba(84,231,212,.2),transparent 24%),
    radial-gradient(circle at 82% 18%,rgba(255,209,102,.13),transparent 22%),
    linear-gradient(145deg,#03171c 0%,#063541 56%,#021015 100%);
  --ambient:
    radial-gradient(circle at 12% 96%,transparent 0 17px,rgba(168,255,243,.2) 18px 19px,transparent 21px),
    radial-gradient(circle at 38% 120%,transparent 0 28px,rgba(84,231,212,.16) 29px 30px,transparent 32px),
    radial-gradient(circle at 74% 110%,transparent 0 12px,rgba(255,255,255,.16) 13px 14px,transparent 16px),
    linear-gradient(180deg,rgba(117,222,218,.08),transparent 42%);
  --ambient-size:210px 210px,260px 260px,170px 170px,100% 100%; --ambient-opacity:.66;
  --surface:linear-gradient(145deg,rgba(8,47,58,.92),rgba(3,25,32,.94));
  --surface2:rgba(196,255,245,.07);
  --chrome:rgba(5,31,39,.8); --field:#052631;
  --shadow:0 16px 38px rgba(0,20,28,.36); --shine:rgba(180,255,244,.1);
  --row-line:rgba(172,246,235,.12); --bar-track:#03202a;
  --bar-fill:linear-gradient(90deg,#31c7c9,#a8fff3);
  --chart-a:#8dfff2; --chart-b:#ffd166;
  --chart-grid:rgba(168,255,243,.2); --chart-cursor:rgba(234,255,250,.5);
  --chart-glow-a:rgba(84,231,212,.7); --chart-glow-b:rgba(255,209,102,.5);
  --chart-bar-a:rgba(83,255,237,.46); --chart-bar-b:rgba(255,209,102,.36);
  --chart-bg:
    radial-gradient(circle at 16% 18%,rgba(141,255,242,.2),transparent 26%),
    radial-gradient(circle at 84% 76%,rgba(255,209,102,.1),transparent 24%),
    linear-gradient(180deg,rgba(111,233,220,.11),rgba(3,23,28,.06));
}
body:has(#theme-tokyo:checked){
  --bg:#100711; --panel:#1c0f24; --panel2:#261638; --line:rgba(255,134,224,.24);
  --fg:#fff2fb; --dim:#d9b5df; --faint:#9b7aa8;
  --ok:#73f4c6; --warn:#ffe36e; --bad:#ff5b8a; --stale:#a88eb2;
  --accent:#ff78d8; --accent-hi:#55e6ff; --accent-soft:rgba(255,120,216,.18);
  --page-bg:
    radial-gradient(circle at 18% 12%,rgba(255,120,216,.24),transparent 24%),
    radial-gradient(circle at 78% 0%,rgba(85,230,255,.2),transparent 25%),
    radial-gradient(circle at 70% 82%,rgba(255,227,110,.1),transparent 22%),
    linear-gradient(135deg,#100711 0%,#17112c 52%,#070914 100%);
  --ambient:
    linear-gradient(115deg,transparent 0 44%,rgba(255,120,216,.12) 45% 46%,transparent 47%),
    repeating-linear-gradient(0deg,rgba(255,255,255,.045) 0 1px,transparent 1px 7px),
    linear-gradient(90deg,rgba(85,230,255,.08) 1px,transparent 1px);
  --ambient-size:130px 130px,100% 7px,52px 52px; --ambient-opacity:.45;
  --surface:linear-gradient(145deg,rgba(36,16,48,.94),rgba(13,10,28,.94));
  --surface2:rgba(255,211,248,.06);
  --chrome:rgba(24,10,33,.82); --field:#170d25;
  --shadow:0 16px 42px rgba(15,0,26,.42); --shine:rgba(255,222,250,.11);
  --row-line:rgba(255,134,224,.12); --bar-track:#120719;
  --bar-fill:linear-gradient(90deg,#ff78d8,#55e6ff);
  --chart-a:#55e6ff; --chart-b:#ff78d8;
  --chart-grid:rgba(255,134,224,.2); --chart-cursor:rgba(255,242,251,.54);
  --chart-glow-a:rgba(85,230,255,.66); --chart-glow-b:rgba(255,120,216,.72);
  --chart-bar-a:rgba(85,230,255,.38); --chart-bar-b:rgba(255,120,216,.42);
  --chart-bg:
    radial-gradient(circle at 18% 16%,rgba(255,120,216,.2),transparent 28%),
    radial-gradient(circle at 78% 76%,rgba(85,230,255,.18),transparent 28%),
    repeating-linear-gradient(90deg,rgba(255,255,255,.035) 0 1px,transparent 1px 10px);
}

/* ============================== base ============================== */
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:var(--bg);color:var(--fg);
  font:14px/1.45 system-ui,-apple-system,'Segoe UI',sans-serif}
body{
  display:grid;grid-template-rows:46px 38px minmax(0,1fr);grid-template-columns:minmax(0,1fr);
  gap:10px;padding:10px;height:100vh;max-width:100vw;
  overflow:hidden;position:relative;isolation:isolate;
  background:var(--page-bg);transition:background .28s ease,color .28s ease;
}
body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
  background:var(--ambient);background-size:var(--ambient-size);opacity:var(--ambient-opacity);
  animation:ambient-drift 26s linear infinite}
body > *{position:relative;z-index:1}
@keyframes ambient-drift{from{background-position:0 0,0 0,0 0,0 0}
  to{background-position:0 -210px,74px -260px,38px -170px,0 0}}
@media (prefers-reduced-motion:reduce){body::before{animation:none}}

.num{font-family:var(--mono);font-variant-numeric:tabular-nums}
.ok{color:var(--ok)}.warn{color:var(--warn)}.bad{color:var(--bad)}.stale{color:var(--stale)}
.dim{color:var(--dim)}.faint{color:var(--faint)}
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:7px;flex:none;
  vertical-align:1px;box-shadow:0 0 0 3px rgba(255,255,255,.03)}
.dot.ok{background:var(--ok);box-shadow:0 0 12px color-mix(in srgb,var(--ok) 55%,transparent)}
.dot.warn{background:var(--warn);box-shadow:0 0 12px color-mix(in srgb,var(--warn) 42%,transparent)}
.dot.bad{background:var(--bad);box-shadow:0 0 12px color-mix(in srgb,var(--bad) 46%,transparent)}
.dot.stale{background:var(--stale)}

/* ============================== header ============================== */
header{display:flex;align-items:center;gap:10px;padding:0 12px;min-width:0;border:1px solid var(--line);
  border-radius:9px;background:var(--chrome);box-shadow:var(--shadow);backdrop-filter:blur(14px)}
header h1{font-size:15px;font-weight:750;letter-spacing:.3px;white-space:nowrap;
  text-shadow:0 0 16px var(--accent-soft)}
.fleet-chips{display:flex;gap:6px;align-items:center;overflow:hidden;flex:1 1 0;min-width:0}
.chip{display:flex;align-items:center;gap:6px;padding:3px 10px;border:1px solid var(--line);
  border-radius:999px;background:var(--surface2);font-size:11.5px;cursor:pointer;white-space:nowrap;
  transition:border-color .18s,color .18s,transform .18s}
.chip:hover{border-color:var(--accent);color:var(--accent-hi);transform:translateY(-1px)}
.chip b{font-weight:650}
.chip .v{font-family:var(--mono);color:var(--dim);font-size:10.5px}
header .clock{font:600 14px var(--mono);color:var(--accent-hi);white-space:nowrap}
header .stamp{font-size:10.5px;color:var(--faint);font-family:var(--mono);white-space:nowrap}
header .err{font-size:11.5px;color:var(--bad);max-width:24ch;overflow:hidden;text-overflow:ellipsis;
  white-space:nowrap}

.theme-dock{position:relative;display:flex;align-items:center;gap:3px;padding:2px;
  border:1px solid var(--line);border-radius:999px;background:rgba(0,0,0,.18)}
.theme-dock input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
.theme-dock label{display:flex;align-items:center;gap:5px;min-height:22px;padding:2px 9px;
  border-radius:999px;color:var(--dim);font-size:11px;font-weight:700;cursor:pointer;
  transition:background .18s,color .18s}
.theme-dock label::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--accent)}
#theme-dark + label::before{background:linear-gradient(135deg,#66d9e8,#f4c76a)}
#theme-ocean + label::before{background:linear-gradient(135deg,#54e7d4,#ffd166)}
#theme-tokyo + label::before{background:linear-gradient(135deg,#ff78d8,#55e6ff)}
.theme-dock input:checked + label{color:var(--fg);background:var(--accent-soft);
  box-shadow:inset 0 0 0 1px var(--line)}

/* ============================== tabs ============================== */
nav{display:flex;align-items:center;gap:6px;padding:0 6px;min-width:0;border:1px solid var(--line);
  border-radius:9px;background:var(--chrome);box-shadow:var(--shadow);backdrop-filter:blur(14px);
  overflow-x:auto;scrollbar-width:none}
nav::-webkit-scrollbar{display:none}
.tab{display:flex;align-items:center;gap:7px;padding:5px 13px;border-radius:7px;cursor:pointer;
  font-size:12.5px;font-weight:650;color:var(--dim);white-space:nowrap;border:1px solid transparent;
  transition:background .16s,color .16s,border-color .16s}
.tab:hover{color:var(--fg);background:var(--surface2)}
.tab.on{color:var(--fg);background:var(--accent-soft);border-color:var(--line)}
.tab kbd{font:600 9.5px var(--mono);color:var(--faint);border:1px solid var(--line);
  border-radius:4px;padding:0 4px;background:rgba(0,0,0,.2)}
.tab .badge{font:700 10px var(--mono);border-radius:999px;padding:1px 6px;background:var(--bad);
  color:#1a0705}
.tab .badge.warn{background:var(--warn);color:#241a03}
nav .spacer{flex:1}
nav .hint{font-size:10.5px;color:var(--faint);padding-right:8px;white-space:nowrap}

/* ============================== views ============================== */
.view{display:none;min-height:0;min-width:0;overflow:auto;gap:10px;grid-auto-columns:minmax(0,1fr)}
.view.on{display:grid}
.view::-webkit-scrollbar{width:6px}.view::-webkit-scrollbar-thumb{background:var(--line);border-radius:99px}

.panel{background:var(--surface);border:1px solid var(--line);border-radius:9px;padding:11px 14px;
  box-shadow:var(--shadow);backdrop-filter:blur(12px);display:flex;flex-direction:column;
  min-height:0;min-width:0;overflow:hidden;position:relative}
.panel::before{content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(180deg,var(--shine),transparent 42%)}
.panel > *{position:relative;z-index:1}
.panel h3{font-size:10px;color:var(--dim);text-transform:uppercase;letter-spacing:.13em;
  margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:8px}
.panel h3 .cnt{color:var(--faint);font-weight:400;text-transform:none;letter-spacing:0;
  font-family:var(--mono);font-size:10.5px}
.scroll{overflow:auto;flex:1;min-height:0;padding-right:2px}
.scroll::-webkit-scrollbar{width:5px}.scroll::-webkit-scrollbar-thumb{background:var(--line);border-radius:99px}
.empty{color:var(--faint);font-size:12.5px;padding:6px 0}

/* bars */
.brow{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.brow label{width:44px;font-size:9.5px;color:var(--dim);text-transform:uppercase;letter-spacing:.12em;
  font-weight:700;flex:none}
.bar{flex:1;height:8px;background:var(--bar-track);border-radius:999px;overflow:hidden;
  box-shadow:inset 0 1px 2px rgba(0,0,0,.42)}
.bar i{display:block;height:100%;border-radius:999px;background:var(--bar-fill);transition:width .5s;
  box-shadow:0 0 12px var(--accent-soft)}
.bar i.w{background:linear-gradient(90deg,#d99430,var(--warn))}
.bar i.b{background:linear-gradient(90deg,#e34e5c,var(--bad))}
.brow .v{flex:0 1 auto;min-width:96px;max-width:60%;text-align:right;font:600 12px var(--mono);
  white-space:nowrap;color:var(--fg);overflow:hidden;text-overflow:ellipsis}
.bar{min-width:48px}

/* ============================== overview ============================== */
#v-overview{grid-template-rows:auto minmax(120px,.85fr) minmax(160px,1.15fr);align-content:start}
.hostrow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;min-width:0}
.hosttile{background:var(--surface);border:1px solid var(--line);border-radius:9px;padding:10px 12px;
  box-shadow:var(--shadow);cursor:pointer;transition:border-color .18s,transform .18s;min-width:0}
.hosttile:hover{border-color:var(--accent);transform:translateY(-1px)}
.hosttile.bad{border-color:color-mix(in srgb,var(--bad) 65%,transparent)}
.hosttile.warn{border-color:color-mix(in srgb,var(--warn) 55%,transparent)}
.hosttile .top{display:flex;align-items:baseline;gap:7px;margin-bottom:2px}
.hosttile .top b{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hosttile .top .up{margin-left:auto;font:11px var(--mono);color:var(--faint);white-space:nowrap}
.hosttile .role{font-size:10.5px;color:var(--faint);margin-bottom:7px;white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis}
.hosttile .facts{display:flex;flex-wrap:wrap;gap:4px 10px;margin-top:7px;font-size:11px;color:var(--dim)}
.hosttile .facts span{white-space:nowrap}
.hosttile .facts b{font-family:var(--mono);color:var(--fg);font-weight:600}
.ov-mid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.85fr) minmax(0,.9fr);
  gap:10px;min-height:0;min-width:0}
.ov-bot{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1.1fr);
  gap:10px;min-height:0;min-width:0}

.alert-row{display:flex;gap:8px;padding:5px 0;border-top:1px solid var(--row-line);font-size:12.5px;
  align-items:baseline}
.alert-row:first-child{border-top:none}
.alert-row .host{font:600 9.5px var(--mono);color:var(--faint);text-transform:uppercase;
  letter-spacing:.06em;flex:none;min-width:56px}
.alert-row .m{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
.allclear{display:flex;align-items:center;gap:8px;color:var(--ok);font-size:13px;padding:6px 0}

.todo-row{display:flex;gap:9px;padding:6px 0;border-top:1px solid var(--row-line);font-size:12.5px;
  align-items:center}
.todo-row:first-child{border-top:none}
.todo-row input{width:15px;height:15px;accent-color:var(--ok);cursor:pointer;flex:none}
.todo-row.done .txt{color:var(--faint);text-decoration:line-through}
.todo-row .txt{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
.todo-row .tag{font-size:10px;padding:2px 8px;border-radius:999px;background:var(--accent-soft);
  border:1px solid var(--line);color:var(--dim);flex:none}
.todo-row .del{color:var(--faint);cursor:pointer;flex:none;padding:0 3px}
.todo-row .del:hover{color:var(--bad)}
.todo-add{margin-top:auto;display:flex;gap:6px;padding-top:8px}
.todo-add input[type=text]{flex:1;background:var(--field);border:1px solid var(--line);border-radius:7px;
  color:var(--fg);padding:6px 10px;font-size:12.5px;min-width:0;outline:none}
.todo-add input[type=text]:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
.todo-add select{background:var(--field);border:1px solid var(--line);border-radius:7px;color:var(--dim);
  font-size:11.5px}
.todo-add button{background:linear-gradient(135deg,var(--accent),var(--accent-hi));border:none;
  border-radius:7px;color:#04101f;font-weight:800;padding:0 14px;cursor:pointer}

.act-row{display:flex;align-items:center;gap:8px;padding:6px 0;border-top:1px solid var(--row-line)}
.act-row:first-child{border-top:none}
.act-row .info{min-width:0;flex:1}
.act-row .info b{font-size:12px;display:block}
.act-row .info span{font-size:10.5px;color:var(--faint);display:block;overflow:hidden;
  text-overflow:ellipsis;white-space:nowrap}
.btn{background:var(--surface2);border:1px solid var(--line);border-radius:6px;color:var(--fg);
  font-size:11px;font-weight:650;padding:4px 10px;cursor:pointer;white-space:nowrap;
  transition:transform .16s,border-color .16s,color .16s,background .16s}
.btn:hover{color:var(--accent-hi);border-color:var(--accent);background:var(--accent-soft);
  transform:translateY(-1px)}
.btn:disabled{opacity:.4;cursor:not-allowed;transform:none}
.btn.go{border-color:color-mix(in srgb,var(--ok) 45%,transparent);color:var(--ok)}
.btn.stop{border-color:color-mix(in srgb,var(--bad) 45%,transparent);color:var(--bad)}
.act-out{font:10.5px/1.4 var(--mono);color:var(--dim);background:rgba(0,0,0,.25);border-radius:6px;
  padding:6px 8px;margin-top:6px;max-height:76px;overflow:auto;white-space:pre-wrap;
  border:1px solid var(--row-line)}

.proj-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;overflow:auto;flex:1;min-height:0;
  align-content:start}
.proj{background:var(--surface2);border:1px solid var(--row-line);border-radius:8px;padding:7px 9px;
  min-width:0;display:flex;flex-direction:column;justify-content:center;transition:border-color .2s,transform .2s}
.proj:hover{border-color:var(--accent);transform:translateY(-1px)}
.proj.alert{border-color:color-mix(in srgb,var(--bad) 70%,transparent);
  background:color-mix(in srgb,var(--bad) 10%,transparent)}
.proj b{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.proj .st{font-size:11px;color:var(--dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  display:flex;align-items:center}
.proj .ago{font:10px var(--mono);color:var(--faint)}

/* ============================== fleet ============================== */
#v-fleet{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:minmax(0,1fr);align-content:start}
.node{background:var(--surface);border:1px solid var(--line);border-radius:9px;padding:13px 15px;
  box-shadow:var(--shadow);display:flex;flex-direction:column;min-height:0;min-width:0;overflow:hidden;position:relative}
.node h2{font-size:15px;color:var(--accent-hi);display:flex;align-items:baseline;gap:10px;
  margin-bottom:11px;text-shadow:0 0 12px var(--accent-soft)}
.node h2 .role{font-size:10.5px;color:var(--faint);font-weight:500;text-transform:uppercase;
  letter-spacing:.07em}
.node h2 .up{color:var(--faint);font-weight:400;font:11px var(--mono);margin-left:auto}
.charts{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin:6px 0 8px}
.chart{background:var(--surface2);border:1px solid var(--row-line);border-radius:8px;
  padding:6px 8px 7px;min-width:0;position:relative;overflow:hidden}
.chart h5{font-size:9px;color:var(--dim);text-transform:uppercase;letter-spacing:.11em;font-weight:700;
  display:flex;align-items:center;gap:6px;margin-bottom:3px;white-space:nowrap;overflow:hidden}
.chart h5 .cur{margin-left:auto;font:600 10px var(--mono);color:var(--fg);display:flex;gap:7px;
  align-items:center;text-transform:none}
.chart h5 .cur i{display:inline-block;width:7px;height:7px;border-radius:999px;margin-right:3px}
.chart canvas{width:100%;height:86px;display:block;cursor:crosshair;position:relative;z-index:1}
.subhead{font-size:10px;color:var(--dim);text-transform:uppercase;letter-spacing:.12em;font-weight:700;
  margin:8px 0 5px;border-top:1px solid var(--line);padding-top:8px;display:flex;justify-content:space-between}
.subhead .cnt{font:400 10px var(--mono);color:var(--faint);text-transform:none;letter-spacing:0}
table{width:100%;border-collapse:collapse}
td{padding:4px 8px 4px 0;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  font-size:12px;border-top:1px solid var(--row-line);max-width:250px}
td.num{text-align:right;padding-right:0}
tr:first-child td{border-top:none}
.offline{display:flex;flex:1;align-items:center;justify-content:center;color:var(--bad);font-size:14px;
  text-align:center;padding:12px}
.ctr-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:4px;overflow:auto;
  align-content:start}
.ctr{display:flex;align-items:center;gap:5px;font-size:11px;padding:3px 6px;border-radius:6px;
  background:var(--surface2);border:1px solid var(--row-line);white-space:nowrap;overflow:hidden}
.ctr.down{border-color:color-mix(in srgb,var(--bad) 60%,transparent);
  background:color-mix(in srgb,var(--bad) 12%,transparent)}
.ctr span{overflow:hidden;text-overflow:ellipsis}
.kv{display:flex;justify-content:space-between;gap:10px;font-size:12px;padding:4px 0;
  border-top:1px solid var(--row-line)}
.kv:first-child{border-top:none}
.kv .k{color:var(--dim)}
.kv .v{font-family:var(--mono);white-space:nowrap}

/* ============================== services ============================== */
#v-services{grid-template-rows:auto minmax(0,1fr)}
.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.toolbar input[type=text]{background:var(--field);border:1px solid var(--line);border-radius:7px;
  color:var(--fg);padding:6px 11px;font-size:12.5px;min-width:180px;flex:1;max-width:340px;outline:none}
.toolbar input[type=text]:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
.pill{border:1px solid var(--line);background:var(--surface2);color:var(--dim);border-radius:999px;
  padding:4px 12px;font-size:11.5px;font-weight:650;cursor:pointer;white-space:nowrap}
.pill.on{color:var(--fg);background:var(--accent-soft);border-color:var(--accent)}
.svc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:8px;
  overflow:auto;align-content:start;padding-right:2px}
.svc-card{background:var(--surface);border:1px solid var(--line);border-radius:9px;padding:9px 11px;
  display:grid;grid-template-columns:1fr auto;gap:3px 8px;align-items:center;box-shadow:var(--shadow)}
.svc-card.waste{background:color-mix(in srgb,var(--bad) 9%,transparent)}
.svc-card.idle{background:color-mix(in srgb,var(--warn) 7%,transparent)}
.svc-card .name{font-size:12.5px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.svc-card .meta{font-size:10.5px;color:var(--faint);white-space:nowrap;overflow:hidden;
  text-overflow:ellipsis;grid-column:1}
.svc-card .used{font:10.5px var(--mono);grid-column:1}
.svc-card .used.waste{color:var(--bad)}.svc-card .used.idle{color:var(--warn)}
.svc-card .used.ok,.svc-card .used.warm{color:var(--dim)}.svc-card .used.off{color:var(--faint)}
.svc-card .acts{display:flex;gap:4px;align-items:center;grid-row:1/4;grid-column:2}
.svc-card select{background:var(--field);border:1px solid var(--line);border-radius:6px;color:var(--dim);
  font-size:11px;padding:3px 4px;max-width:92px}
.svc-op{font-size:11.5px;color:var(--warn);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* ============================== automation ============================== */
#v-automation,#v-backups,#v-launcher{grid-template-rows:auto minmax(0,1fr)}
.jobs{overflow:auto;padding-right:2px}
.jobs table{border-collapse:separate;border-spacing:0}
.jobs thead th{position:sticky;top:0;background:var(--panel);z-index:2;text-align:left;
  font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);font-weight:700;
  padding:7px 10px 7px 0;border-bottom:1px solid var(--line)}
.jobs td{font-size:12px;padding:6px 10px 6px 0;border-top:1px solid var(--row-line);max-width:none}
.jobs tr:hover td{background:var(--surface2)}
.jobs .jname{font-weight:600;max-width:340px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.jobs .jdetail{color:var(--faint);font-size:10.5px;max-width:420px;overflow:hidden;
  text-overflow:ellipsis;white-space:nowrap}
.lay{font:700 9.5px var(--mono);padding:2px 7px;border-radius:999px;border:1px solid var(--line);
  background:var(--surface2);color:var(--dim);text-transform:uppercase}
.lay.hermes{color:var(--accent)}.lay.crontab{color:var(--accent-hi)}.lay.timer{color:var(--ok)}

/* ============================== backups ============================== */
.bk-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px;overflow:auto;
  align-content:start}
.bk{background:var(--surface);border:1px solid var(--line);border-radius:9px;padding:11px 13px;
  box-shadow:var(--shadow);display:flex;flex-direction:column;gap:5px}
.bk.warn{border-color:color-mix(in srgb,var(--warn) 60%,transparent)}
.bk.fail{border-color:color-mix(in srgb,var(--bad) 70%,transparent);
  background:color-mix(in srgb,var(--bad) 9%,transparent)}
.bk .h{display:flex;align-items:baseline;gap:8px}
.bk .h b{font-size:13px}
.bk .h .tier{font:700 9.5px var(--mono);color:var(--faint);border:1px solid var(--line);
  border-radius:999px;padding:1px 7px}
.bk .h .age{margin-left:auto;font:600 12px var(--mono)}
.bk .d{font-size:11.5px;color:var(--dim);overflow:hidden;text-overflow:ellipsis}
.bk .n{font-size:11px;color:var(--warn)}
.bk .t{font-size:10.5px;color:var(--faint);font-family:var(--mono)}

/* ============================== launcher ============================== */
.launch-wrap{overflow:auto;padding-right:2px}
.lgroup{margin-bottom:14px}
.lgroup h4{font-size:10px;color:var(--dim);text-transform:uppercase;letter-spacing:.13em;
  margin-bottom:8px;display:flex;gap:8px;align-items:center}
.lgroup h4 .cnt{color:var(--faint);font:400 10px var(--mono);letter-spacing:0}
.ltiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(178px,1fr));gap:8px}
.ltile{display:flex;flex-direction:column;gap:2px;background:var(--surface);border:1px solid var(--line);
  border-radius:9px;padding:10px 12px;text-decoration:none;color:var(--fg);box-shadow:var(--shadow);
  transition:transform .16s,border-color .16s,background .16s;min-width:0}
.ltile:hover{transform:translateY(-2px);border-color:var(--accent);background:var(--accent-soft)}
.ltile b{font-size:12.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  display:flex;align-items:center}
.ltile span{font:10.5px var(--mono);color:var(--faint);white-space:nowrap;overflow:hidden;
  text-overflow:ellipsis}
.ltile.down{opacity:.55}

/* ============================== responsive ============================== */
@media (max-width:1560px),(max-height:880px){
  /* Below a full desktop the page scrolls instead of squeezing panels to nothing */
  body{height:auto;min-height:100vh;overflow:auto;grid-template-rows:auto auto auto}
  .view{overflow:visible}
  #v-overview{grid-template-rows:auto auto auto}
  .panel{min-height:180px}
  .node{min-height:400px}
  .svc-grid,.bk-grid,.jobs,.launch-wrap,.scroll{overflow:visible}
  .jobs{max-height:none}
}
@media (max-width:1400px){
  .ov-mid,.ov-bot{grid-template-columns:repeat(2,minmax(0,1fr))}
  .hostrow{grid-template-columns:repeat(2,minmax(0,1fr))}
  /* odd panel out spans the row instead of leaving a hole beside it */
  .ov-mid > .panel:nth-child(3),.ov-bot > .panel:nth-child(3){grid-column:1/-1}
}
@media (max-width:1000px){
  #v-fleet{grid-template-columns:minmax(0,1fr)}
  .ov-mid,.ov-bot{grid-template-columns:minmax(0,1fr)}
}
@media (max-width:640px){
  body{padding:8px;gap:8px}
  header{flex-wrap:wrap;padding:8px 10px;height:auto}
  .fleet-chips{order:3;width:100%;overflow-x:auto}
  header .stamp{display:none}
  .hostrow{grid-template-columns:1fr}
  .brow .v{width:132px;font-size:11px}
  .tab kbd{display:none}
}
</style>
