<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Spark Console</title>
<style>
:root{
  --bg:#0d1117; --panel:#151b23; --panel2:#1d242e; --line:#2b333e;
  --fg:#e9eef4; --dim:#93a0ad; --faint:#616d79;
  --ok:#41c157; --warn:#e0a52c; --bad:#ff5d52; --stale:#8b98a5;
  --accent:#5aa9ff; --mono:'SFMono-Regular',ui-monospace,Menlo,Consolas,monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--fg);
  font:14px/1.4 system-ui,-apple-system,'Segoe UI',sans-serif}
body{display:grid;grid-template-rows:34px 1.25fr 1fr;gap:8px;padding:8px;height:100vh}
.num{font-family:var(--mono)}
.ok{color:var(--ok)}.warn{color:var(--warn)}.bad{color:var(--bad)}.stale{color:var(--stale)}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:7px;vertical-align:0;flex:none}
.dot.ok{background:var(--ok)}.dot.warn{background:var(--warn)}.dot.bad{background:var(--bad)}.dot.stale{background:var(--stale)}

header{display:flex;align-items:center;gap:14px;padding:0 6px}
header h1{font-size:17px;font-weight:700;letter-spacing:.3px}
header .sub{color:var(--faint);font-size:12px}
header a{color:var(--faint);font-size:11px;text-decoration:none;border:1px solid var(--line);
  border-radius:10px;padding:1px 9px}
header a:hover{color:var(--accent)}
header .clock{margin-left:auto;font:600 15px var(--mono);color:var(--dim)}
header .stamp{font-size:11px;color:var(--faint)}
header .err{font-size:12px;color:var(--bad)}

.nodes{display:grid;grid-template-columns:1fr 1fr;gap:8px;min-height:0}
.node{background:var(--panel);border:1px solid var(--line);border-radius:10px;
  padding:12px 16px;display:flex;flex-direction:column;min-height:0;overflow:hidden}
.node h2{font-size:16px;color:var(--accent);display:flex;align-items:baseline;gap:10px;margin-bottom:10px}
.node h2 .role{font-size:12px;color:var(--faint);font-weight:400}
.node h2 .up{color:var(--faint);font-weight:400;font-size:12px;margin-left:auto}
.brow{display:flex;align-items:center;gap:12px;margin-bottom:6px}
.brow label{width:52px;font-size:12px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px}
.bar{flex:1;height:11px;background:#232b35;border-radius:6px;overflow:hidden}
.bar i{display:block;height:100%;border-radius:7px;background:var(--accent);transition:width .5s}
.bar i.w{background:var(--warn)}.bar i.b{background:var(--bad)}
.brow .v{width:170px;text-align:right;font:600 13px var(--mono);white-space:nowrap}
.charts{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:4px 0 6px}
.chart{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:5px 8px 6px;min-width:0}
.chart h5{font-size:10px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px;font-weight:600;
  display:flex;align-items:center;gap:6px;margin-bottom:3px;white-space:nowrap;overflow:hidden}
.chart h5 .cur{margin-left:auto;font:600 10.5px var(--mono);color:var(--fg);display:flex;gap:7px;align-items:center;text-transform:none}
.chart h5 .cur i{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:3px;vertical-align:-1px}
.chart canvas{width:100%;height:74px;display:block;cursor:crosshair}
.models{margin-top:auto;border-top:1px solid var(--line);padding-top:8px}
.models h4{font-size:11px;color:var(--dim);text-transform:uppercase;letter-spacing:.6px;margin-bottom:5px}
table{width:100%;border-collapse:collapse}
td{padding:4px 8px 4px 0;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  font-size:13px;border-top:1px solid #1c232c;max-width:260px}
td.num{text-align:right;padding-right:0}
tr:first-child td{border-top:none}
.offline{display:flex;flex:1;align-items:center;justify-content:center;color:var(--bad);font-size:15px;text-align:center;padding:10px}

.bottom{display:grid;grid-template-columns:1.35fr 1fr .95fr 1fr;gap:8px;min-height:0}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;
  padding:10px 14px;overflow:hidden;display:flex;flex-direction:column;min-height:0}
.panel h3{font-size:12px;color:var(--dim);text-transform:uppercase;letter-spacing:.7px;margin-bottom:7px;
  display:flex;justify-content:space-between;align-items:center}
.panel h3 .cnt{color:var(--faint);font-weight:400;text-transform:none}
.scrollless{overflow:auto;flex:1;min-height:0}
.svc-row{display:grid;grid-template-columns:1fr auto;gap:2px 8px;padding:5px 0;border-top:1px solid #1c232c;align-items:center}
.svc-row:first-child{border-top:none}
.svc-row.waste{background:rgba(255,93,82,.06)}
.svc-row.idle{background:rgba(224,165,44,.05)}
.svc-row .name{font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.svc-row .meta{font-size:10.5px;color:var(--faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.svc-row .used{font-size:10.5px;font-family:var(--mono)}
.svc-row .used.waste{color:var(--bad)}.svc-row .used.idle{color:var(--warn)}
.svc-row .used.ok,.svc-row .used.warm{color:var(--dim)}.svc-row .used.off{color:var(--faint)}
.svc-row .acts{display:flex;gap:4px;align-items:center;flex-wrap:nowrap}
.svc-btn{background:var(--panel2);border:1px solid var(--line);border-radius:5px;color:var(--fg);
  font-size:11px;padding:2px 8px;cursor:pointer;font-weight:600}
.svc-btn:hover{border-color:var(--accent);color:var(--accent)}
.svc-btn:disabled{opacity:.4;cursor:not-allowed}
.svc-btn.go{border-color:#2a6a3a;color:var(--ok)}
.svc-btn.stop{border-color:#6a2a2a;color:var(--bad)}
.svc-row select{background:var(--panel2);border:1px solid var(--line);border-radius:5px;color:var(--dim);
  font-size:11px;padding:2px 4px;max-width:88px}
.svc-op{font-size:11px;color:var(--warn);margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.svc-group{font-size:10px;color:var(--faint);text-transform:uppercase;letter-spacing:.6px;padding:8px 0 2px;
  border-top:1px solid var(--line);margin-top:2px}
.svc-group:first-child{border-top:none;padding-top:0;margin-top:0}
.alert-row{display:flex;gap:10px;padding:4px 0;border-top:1px solid #1c232c;font-size:13px;align-items:baseline}
.alert-row:first-child{border-top:none}
.alert-row .m{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.todo-row{display:flex;gap:10px;padding:5px 0;border-top:1px solid #1c232c;font-size:13.5px;align-items:center}
.todo-row:first-child{border-top:none}
.todo-row input{width:15px;height:15px;accent-color:var(--ok);cursor:pointer;flex:none}
.todo-row.done span.txt{color:var(--faint);text-decoration:line-through}
.todo-row .txt{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
.todo-row .tag{font-size:10.5px;padding:1px 8px;border-radius:10px;
  background:var(--panel2);border:1px solid var(--line);color:var(--dim);flex:none}
.todo-row .del{color:var(--faint);cursor:pointer;flex:none;padding:0 3px}
.todo-row .del:hover{color:var(--bad)}
.todo-add{margin-top:auto;display:flex;gap:6px;padding-top:8px}
.todo-add input[type=text]{flex:1;background:var(--panel2);border:1px solid var(--line);border-radius:6px;
  color:var(--fg);padding:5px 10px;font-size:13px;min-width:0}
.todo-add select{background:var(--panel2);border:1px solid var(--line);border-radius:6px;color:var(--dim);font-size:12px}
.todo-add button{background:var(--accent);border:none;border-radius:6px;color:#04101f;
  font-weight:700;padding:0 14px;cursor:pointer}

.proj-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;flex:1;min-height:0}
.proj{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:7px 10px;min-width:0;display:flex;flex-direction:column;justify-content:center}
.proj.alert{border-color:var(--bad)}
.proj b{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.proj .st{font-size:12px;color:var(--dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:flex;align-items:center}
.proj .ago{font-size:10.5px;color:var(--faint)}

