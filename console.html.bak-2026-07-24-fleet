    <label for="theme-tokyo" title="Tokyo anime mode">Tokyo</label>
  </div>
  <span class="stamp" id="stamp"></span>
  <span class="err" id="err"></span>
  <span class="clock" id="clock"></span>
</header>

<div class="nodes" id="nodes"><div class="node"><div class="offline stale">loading…</div></div>
<div class="node"><div class="offline stale">loading…</div></div></div>

<div class="bottom">
  <div class="panel"><h3>Services <span class="cnt" id="svc-cnt"></span></h3>
    <div class="svc-op" id="svc-op" hidden></div>
    <div class="scrollless" id="services"></div></div>
  <div class="panel"><h3>Alerts <span class="cnt" id="alert-cnt"></span></h3>
    <div class="scrollless" id="alerts"></div></div>
  <div class="panel"><h3>Todo · Home <span class="cnt" id="todo-cnt"></span></h3>
    <div class="scrollless" id="todos"></div>
    <div class="todo-add">
      <input type="text" id="todo-in" placeholder="add item…">
      <select id="todo-tag"><option>home</option><option>stack</option><option>models</option><option>hermes</option><option>backups</option></select>
      <button onclick="addTodo()">+</button></div></div>
  <div class="panel"><h3>Projects</h3><div class="proj-grid" id="projects"></div></div>
</div>

<script>
const $=id=>document.getElementById(id);
const esc=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const cls=p=>p>=90?"b":p>=70?"w":"";
const stDot=s=>`<span class="dot ${s==='ok'?'ok':s==='warn'?'warn':s==='stale'?'stale':'bad'}"></span>`;
const pct=(u,t)=>t?Math.round(u/t*100):0;
const row=(l,p,v)=>`<div class="brow"><label>${l}</label><div class="bar"><i class="${cls(p)}" style="width:${Math.min(p,100)}%"></i></div><div class="v">${v}</div></div>`;

// ---- rolling history charts (GNOME System Monitor style; visual-only theme paint) ----
const cssVar=(name,fallback)=>getComputedStyle(document.body).getPropertyValue(name).trim()||fallback;
const chartPaint=()=>({
  a:cssVar("--chart-a","#3d8ee8"), b:cssVar("--chart-b","#e8654a"),
  grid:cssVar("--chart-grid","rgba(139,152,165,.14)"), cursor:cssVar("--chart-cursor","rgba(233,238,244,.45)"),
  glowA:cssVar("--chart-glow-a","rgba(61,142,232,.45)"), glowB:cssVar("--chart-glow-b","rgba(232,101,74,.38)"),
  barA:cssVar("--chart-bar-a","rgba(61,142,232,.28)"), barB:cssVar("--chart-bar-b","rgba(232,101,74,.25)"),
  panel:cssVar("--panel","#151b23")
});
const CHARTS=[
  {key:"cpu", title:"CPU · GPU",  a:{f:"cpu",label:"cpu"}, b:{f:"gpu",label:"gpu"}, unit:"%", max:100},
  {key:"mem", title:"Mem · Swap", a:{f:"mem",label:"mem"}, b:{f:"swap",label:"swap"}, unit:"%", max:100},
  {key:"net", title:"Net rx · tx",a:{f:"rx",label:"rx"},  b:{f:"tx",label:"tx"},  unit:"K/s", max:0},
];
const chartsBlock=nid=>`<div class="charts">${CHARTS.map(c=>`
  <div class="chart"><h5>${c.title}<span class="cur" id="${nid}-${c.key}-cur"></span></h5>
  <canvas id="${nid}-${c.key}" data-node="${nid}" data-chart="${c.key}"></canvas></div>`).join("")}</div>`;

let sparks={node1:[],node2:[]};
const niceMax=v=>{const steps=[64,128,256,512,1024,2048,5120,10240,51200,102400,1048576];
  for(const s of steps)if(v<=s)return s;return Math.ceil(v/1048576)*1048576;};
const fmtK=v=>v>=1024?(v/1024).toFixed(v>=10240?0:1)+" M/s":Math.round(v)+" K/s";

function drawChart(cv,samples,cfg,hoverX){
  const dpr=window.devicePixelRatio||1;
  const w=cv.clientWidth,h=cv.clientHeight;
  if(!w||!h)return;
  if(cv.width!==w*dpr||cv.height!==h*dpr){cv.width=w*dpr;cv.height=h*dpr;}
  const x=cv.getContext("2d");x.setTransform(dpr,0,0,dpr,0,0);x.clearRect(0,0,w,h);
  const paint=chartPaint();
  const win=60, tmax=samples.length?samples[samples.length-1].t:0, tmin=tmax-win;
  const pts=samples.filter(s=>s.t>=tmin);
  let ymax=cfg.max;
  if(!ymax){ymax=niceMax(Math.max(64,...pts.map(p=>Math.max(p[cfg.a.f],p[cfg.b.f]))));}
  const X=t=>(t-tmin)/win*w, Y=v=>h-Math.min(v,ymax)/ymax*(h-4)-2;

  x.save();
  const veil=x.createLinearGradient(0,0,0,h);
  veil.addColorStop(0,"rgba(255,255,255,.045)");
  veil.addColorStop(.58,"rgba(255,255,255,.01)");
  veil.addColorStop(1,"rgba(0,0,0,.16)");
  x.fillStyle=veil;x.fillRect(0,0,w,h);
  x.restore();

  x.strokeStyle=paint.grid;x.lineWidth=1;
  for(const fr of[.25,.5,.75]){x.beginPath();x.moveTo(0,h*fr);x.lineTo(w,h*fr);x.stroke();}
  for(let t=Math.ceil(tmin/10)*10;t<=tmax;t+=10){
    const px=X(t);x.beginPath();x.moveTo(px,0);x.lineTo(px,h);x.stroke();}

  if(pts.length){
    const maxBars=Math.min(34,Math.max(1,pts.length));
    const stride=Math.max(1,Math.ceil(pts.length/maxBars));
    const barW=Math.max(1.5,Math.min(5.5,w/(maxBars*2.6)));
    const gradA=x.createLinearGradient(0,0,0,h);gradA.addColorStop(0,paint.barA);gradA.addColorStop(1,"rgba(0,0,0,0)");
    const gradB=x.createLinearGradient(0,0,0,h);gradB.addColorStop(0,paint.barB);gradB.addColorStop(1,"rgba(0,0,0,0)");
    x.save();x.shadowBlur=10;
    for(let i=0;i<pts.length;i+=stride){
      const p=pts[i], px=X(p.t), ya=Y(p[cfg.a.f]), yb=Y(p[cfg.b.f]);
      x.shadowColor=paint.glowA;x.fillStyle=gradA;x.fillRect(px-barW-1,ya,barW,h-ya);
      x.shadowColor=paint.glowB;x.fillStyle=gradB;x.fillRect(px+1,yb,barW,h-yb);
    }
    x.restore();
  }

  const series=(f,color,glow,alpha)=>{
    if(pts.length<2)return;
    x.beginPath();pts.forEach((p,i)=>i?x.lineTo(X(p.t),Y(p[f])):x.moveTo(X(p.t),Y(p[f])));
    x.lineTo(X(pts[pts.length-1].t),h);x.lineTo(X(pts[0].t),h);x.closePath();
    x.save();x.globalAlpha=alpha;x.fillStyle=color;x.fill();x.restore();
    x.save();x.beginPath();pts.forEach((p,i)=>i?x.lineTo(X(p.t),Y(p[f])):x.moveTo(X(p.t),Y(p[f])));
    x.shadowColor=glow;x.shadowBlur=12;x.strokeStyle=color;x.lineWidth=2.25;x.lineJoin="round";x.stroke();x.restore();
    x.save();x.beginPath();pts.forEach((p,i)=>i?x.lineTo(X(p.t),Y(p[f])):x.moveTo(X(p.t),Y(p[f])));
    x.globalAlpha=.72;x.strokeStyle=color;x.lineWidth=1;x.stroke();x.restore();
  };
  series(cfg.b.f,paint.b,paint.glowB,.1);series(cfg.a.f,paint.a,paint.glowA,.14);

  let cur=pts[pts.length-1];
  if(hoverX!=null&&pts.length){
    let best=pts[0];for(const p of pts)if(Math.abs(X(p.t)-hoverX)<Math.abs(X(best.t)-hoverX))best=p;
    cur=best;
    x.strokeStyle=paint.cursor;x.lineWidth=1;
    x.beginPath();x.moveTo(X(cur.t),0);x.lineTo(X(cur.t),h);x.stroke();
    for(const[f,c,g]of[[cfg.a.f,paint.a,paint.glowA],[cfg.b.f,paint.b,paint.glowB]]){
      x.save();x.shadowColor=g;x.shadowBlur=12;x.beginPath();x.arc(X(cur.t),Y(cur[f]),3.25,0,7);x.fillStyle=c;x.fill();
      x.strokeStyle=paint.panel;x.lineWidth=2;x.stroke();x.restore();}
  }
  const curEl=$(cv.id+"-cur");
  if(curEl){
    const fv=v=>cfg.unit==="%"?Math.round(v)+"%":fmtK(v);
    curEl.innerHTML=cur?`<span><i style="background:${paint.a}"></i>${fv(cur[cfg.a.f])}</span><span><i style="background:${paint.b}"></i>${fv(cur[cfg.b.f])}</span>`:"—";
  }
}

const hoverState={};
function drawAll(){
  for(const nid of["node1","node2"])for(const c of CHARTS){
    const cv=$(nid+"-"+c.key);
    if(cv)drawChart(cv,sparks[nid]||[],c,hoverState[cv.id]);
  }
}
document.addEventListener("mousemove",e=>{
  if(e.target.tagName==="CANVAS"&&e.target.dataset.chart){
    hoverState[e.target.id]=e.offsetX;drawAll();}
});
document.addEventListener("mouseout",e=>{
  if(e.target.tagName==="CANVAS"&&e.target.dataset.chart){
    delete hoverState[e.target.id];drawAll();}
});
document.querySelectorAll(".theme-dock input").forEach(input=>input.addEventListener("change",()=>requestAnimationFrame(drawAll)));
async function pollSparks(){
  try{
    const r=await fetch("/api/sparks",{cache:"no-store"});
    sparks=await r.json();drawAll();
  }catch(e){/* transient */}
}
setInterval(pollSparks,2000);

function node1Html(n){
  const s=n.system||{};
  const g=(n.gpus||[])[0]||{};
  const mp=s.mem_pct||0, sp=pct(s.swap_used_gb,s.swap_total_gb);
  const mods=(n.endpoints||[]).map(e=>({label:e.id,sub:`${e.engine} :${e.port}`,val:"serving",status:"ok"}));
  (n.ollama||[]).forEach(m=>mods.push({label:m.name,sub:"ollama :11434",val:m.size||"",status:m.stuck?"bad":"ok"}));
  (n.processes||[]).filter(p=>p.mem_mb>4000&&!/llama-server/.test(p.name))
    .forEach(p=>mods.push({label:p.name.split("/").pop(),sub:"proc",val:(p.mem_mb/1024).toFixed(1)+" G",status:"ok"}));
  return `<div class="node"><h2>${esc(n.hostname||"sparkmax-10ef")} <span class="role">node1 · primary</span><span class="up">${new Date(n.iso_ts).toLocaleTimeString()}</span></h2>
    ${row("GPU",g.util_gpu||0,`${g.util_gpu??"?"}% · ${g.temp_c??"?"}°C · ${g.power_w??"?"} W`)}
    ${row("CPU",s.cpu_pct||0,`${s.cpu_pct??"?"}% · ${s.load_1??"?"} / ${s.load_5??"?"} / ${s.load_15??"?"}`)}
    ${row("Mem",mp,`${s.mem_used_gb??"?"} / ${s.mem_total_gb??"?"} G (${mp}%)`)}
    ${row("Swap",sp,`${s.swap_used_gb??"?"} / ${s.swap_total_gb??"?"} G`)}
    ${row("Disk",s.disk_used_pct||0,`${s.disk_used_pct??"?"}% · ${s.disk_free_tb??"?"} TB free`)}
    ${chartsBlock("node1")}
    <div class="models"><h4>Models · inference</h4><table>
    ${mods.length?mods.map(m=>`<tr><td title="${esc(m.label)}">${esc(m.label)}</td>
      <td style="color:var(--faint)">${esc(m.sub)}</td>
      <td class="num">${esc(m.val)}</td><td>${stDot(m.status)}${m.status==="bad"?"<span class=bad>stuck</span>":"ok"}</td></tr>`).join("")
      :`<tr><td class="stale">nothing serving</td></tr>`}
    </table></div></div>`;
}

function node2Html(n){
  if(!n||!n.reachable)
    return `<div class="node"><h2>sparkymaxxx-12ef <span class="role">node2 · deep lane</span></h2>
      <div class="offline">node2 unreachable — ${esc(n&&n.error||"no data")}</div></div>`;
  const mp=n.mem?n.mem.pct:0, sp=n.swap?pct(n.swap.used_gb,n.swap.total_gb):0;
  const g=(n.gpus||[])[0]||{};
  const mods=(n.models||[]).map(m=>({label:m.id,sub:`${m.engine} :${m.port}`,val:"serving",status:"ok"}));
  (n.top_procs||[]).filter(p=>p.mem_gb>=1)
    .forEach(p=>mods.push({label:p.name,sub:"proc",val:p.mem_gb+" G",status:"ok"}));
  return `<div class="node"><h2>${esc(n.hostname)} <span class="role">node2 · deep lane</span><span class="up">up ${esc(n.uptime)}</span></h2>
    ${row("GPU",g.util_gpu||0,`${g.util_gpu??"?"}% · ${g.temp_c??"?"}°C · ${g.power_w??"?"} W`)}
    ${row("CPU",n.cpu_pct||0,`load ${esc(n.load)}`)}
    ${row("Mem",mp,`${n.mem.used_gb} / ${n.mem.total_gb} G (${mp}%)`)}
    ${row("Swap",sp,`${n.swap.used_gb} / ${n.swap.total_gb} G`)}
    ${row("Disk",n.disk?n.disk.pct:0,`${n.disk?n.disk.pct:"?"}% · ${n.disk?n.disk.free_tb:"?"} TB free`)}
    ${chartsBlock("node2")}
    <div class="models"><h4>Models · inference</h4><table>
    ${mods.length?mods.map(m=>`<tr><td title="${esc(m.label)}">${esc(m.label)}</td>
      <td style="color:var(--faint)">${esc(m.sub)}</td><td class="num">${esc(m.val)}</td>
      <td>${stDot(m.status)}ok</td></tr>`).join("")
      :`<tr><td class="stale">nothing serving</td></tr>`}
    </table></div></div>`;
}

function alertsHtml(node1,node2,projects){
  const list=[];
  (node1.alerts||[]).forEach(a=>list.push({s:a.level==="critical"?"bad":a.level==="warning"?"warn":"stale",m:`n1 ${a.message}`}));
  if(node2&&!node2.reachable)list.push({s:"bad",m:"node2 unreachable over fabric ("+(node2.error||"?")+")"});
  if(node2&&node2.reachable&&node2.swap&&node2.swap.used_gb>=2)
    list.push({s:"warn",m:`n2 swap ${node2.swap.used_gb} G — memory pressure`});
  (projects||[]).filter(p=>p.status==="bad").forEach(p=>list.push({s:"bad",m:`${p.name}: ${p.detail}`}));
  const crit=list.filter(a=>a.s==="bad").length;
  $("alert-cnt").textContent=crit?`${crit} critical`:"all clear";
  $("alerts").innerHTML=list.length?list.slice(0,9).map(a=>
    `<div class="alert-row">${stDot(a.s)}<span class="m" title="${esc(a.m)}">${esc(a.m)}</span></div>`).join("")
    :`<div class="alert-row">${stDot("ok")}<span class="m stale">no active alerts</span></div>`;
}

function todosHtml(todos){
  const open=todos.filter(t=>!t.done).length;
  $("todo-cnt").textContent=`${open} open`;
  const sorted=[...todos.filter(t=>!t.done),...todos.filter(t=>t.done)].slice(0,9);
  $("todos").innerHTML=sorted.length?sorted.map(t=>
    `<div class="todo-row ${t.done?"done":""}">
     <input type="checkbox" ${t.done?"checked":""} onchange="todoAction('toggle','${esc(t.id)}')">
     <span class="txt" title="${esc(t.text)}">${esc(t.text)}</span>
     <span class="tag">${esc(t.tag)}</span>
     <span class="del" title="delete" onclick="todoAction('delete','${esc(t.id)}')">✕</span></div>`).join("")
    :`<div class="todo-row"><span class="txt stale">nothing on the list</span></div>`;
}

function projectsHtml(projects){
  $("projects").innerHTML=(projects||[]).map(p=>
    `<div class="proj ${p.status==="bad"?"alert":""}"><b title="${esc(p.name)}">${esc(p.name)}</b>
     <span class="st">${stDot(p.status)}<span style="overflow:hidden;text-overflow:ellipsis" title="${esc(p.detail)}">${esc(p.detail)}</span></span>
     <span class="ago">${esc(p.ago)}</span></div>`).join("")||`<div class="stale">no data yet</div>`;
}

function svcDot(s){
  if(s==="active"||s===true)return "ok";
  if(s==="activating"||s==="reloading")return "warn";
  if(s==="inactive"||s==="failed"||s==="dead")return s==="failed"?"bad":"stale";
  return "stale";
}

function servicesHtml(bundle){
  const list=(bundle&&bundle.services)||[];
  const op=bundle&&bundle.active_operation;
  const up=list.filter(s=>s.active).length;
  const waste=(bundle.waste_ids||[]).length;
  const idleN=(bundle.idle_ids||[]).length;
  $("svc-cnt").textContent=waste?`${up} up · ${waste} waste`:idleN?`${up} up · ${idleN} idle`:`${up}/${list.length} up`;
  const opEl=$("svc-op");
  if(op&&op.status==="running"){
    opEl.hidden=false;
    opEl.textContent=`⏳ ${op.type} ${op.key}: ${op.message||"running…"}`;
  }else if(op&&op.status==="failed"){
    opEl.hidden=false;
    opEl.textContent=`✕ ${op.type} ${op.key} failed`;
  }else if(waste){
    opEl.hidden=false;
    opEl.textContent=`⚡ ${waste} running with no recent use — consider Stop`;
  }else{
    opEl.hidden=true;opEl.textContent="";
  }
  const busy=!!(op&&op.status==="running");
  const gLabel={inference:"Inference",hermes:"Hermes",apps:"Apps · websites",meta:"Meta"};
  let html="", prevG=null;
  for(const s of list){
    if(s.group!==prevG){
      prevG=s.group;
      html+=`<div class="svc-group">${esc(gLabel[s.group]||s.group)}</div>`;
    }
    const st=s.active?"ok":(s.state==="failed"||s.unit_missing?"bad":"stale");
    const canStop=!s.no_stop&&s.active&&!s.unit_missing;
    const canStart=!s.active&&!s.unit_missing;
    let modelSel="";
    if(s.id==="node2-deep"&&s.models&&s.models.length){
      const cur=s.model_key||s.default_model||s.models[0];
      modelSel=`<select id="svc-model-${esc(s.id)}" title="model" ${busy?"disabled":""}>
        ${s.models.map(m=>`<option value="${esc(m)}" ${m===cur?"selected":""}>${esc(m)}</option>`).join("")}
      </select>`;
    }
    const idle=s.idle||"unknown";
    const usedTitle=s.last_used_source?`via ${s.last_used_source}`:"";
    const usedTxt=s.active
      ? `last use ${esc(s.last_used_ago||"?")}${idle==="waste"?" · STOP?":idle==="idle"?" · idle":""}`
      : (s.unit_missing?"no unit":"stopped");
    const extra=s.serving?esc(s.serving):esc((s.extra||"").replace(/^up · ok$/,"up"));
    html+=`<div class="svc-row ${idle==="waste"||idle==="idle"?idle:""}" title="${esc(s.hint||s.detail||"")}">
      <div>
        <div class="name">${stDot(st)}${esc(s.label)}</div>
        <div class="meta">${esc(s.detail)}${extra?` · ${extra}`:""}</div>
        <div class="used ${esc(idle)}" title="${esc(usedTitle)}">${usedTxt}</div>
      </div>
      <div class="acts">
        ${modelSel}
        <button class="svc-btn go" ${canStart&&!busy?"":"disabled"}
          onclick="svcAction('${esc(s.id)}','start')">Start</button>
        <button class="svc-btn stop" ${canStop&&!busy?"":"disabled"}
          onclick="svcAction('${esc(s.id)}','stop')">Stop</button>
      </div>
    </div>`;
  }
  $("services").innerHTML=html||`<div class="stale">no service data</div>`;
}

async function svcAction(id,action){
  if(action==="stop"){
    const critical=["llama-miaai35","hermes-orchestrator"];
    if(critical.includes(id)&&!confirm(`Stop ${id}? Hermes / agents may fail until it is back.`))return;
  }
  let model=null;
  if(id==="node2-deep"&&action==="start"){
    const sel=$("svc-model-node2-deep");
    model=sel?sel.value:null;
  }
  try{
    $("err").textContent=`${action} ${id}…`;
    const r=await fetch("/api/services/"+encodeURIComponent(id),{
      method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({action,model})
    });
    const d=await r.json();
    if(!d.ok){$("err").textContent=d.error||"action failed";return;}
    $("err").textContent=d.operation?`queued: ${d.operation.message}`:(d.message||"ok");
    for(let i=0;i<6;i++){
      await new Promise(res=>setTimeout(res,i===0?800:2000));
      const sr=await fetch("/api/services",{cache:"no-store"});
      servicesHtml(await sr.json());
    }
    await refresh();
  }catch(e){$("err").textContent="service action failed: "+e.message;}
}

async function refresh(){
  try{
    const r=await fetch("/api/overview",{cache:"no-store"});
    const d=await r.json();
    $("nodes").innerHTML=node1Html(d.node1)+node2Html(d.node2);
    drawAll();  // innerHTML re-render clears the canvases
    alertsHtml(d.node1,d.node2,d.projects);
    todosHtml(d.todos||[]);
    projectsHtml(d.projects);
    servicesHtml(d.services||{});
    $("stamp").textContent="updated "+new Date().toLocaleTimeString();
    $("err").textContent="";
  }catch(e){$("err").textContent="refresh failed: "+e.message;}
}

async function todoAction(action,id){
  try{
    const r=await fetch("/api/todos",{method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({action,id})});
    todosHtml((await r.json()).todos||[]);
  }catch(e){$("err").textContent="todo failed: "+e.message;}
}
async function addTodo(){
  const el=$("todo-in"), text=el.value.trim();
  if(!text)return;
  el.value="";
  try{
    const r=await fetch("/api/todos",{method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({action:"add",text,tag:$("todo-tag").value})});
    todosHtml((await r.json()).todos||[]);
  }catch(e){$("err").textContent="todo failed: "+e.message;}
}
$("todo-in").addEventListener("keydown",e=>{if(e.key==="Enter")addTodo();});

const tick=()=>$("clock").textContent=new Date().toLocaleTimeString();
tick();setInterval(tick,1000);
refresh();setInterval(refresh,10000);
</script>
</body>
</html>
