html,body{background:var(--bg)}
body{
  position:relative;
  isolation:isolate;
  grid-template-rows:42px 1.25fr 1fr;
  gap:10px;
  padding:10px;
  background:var(--page-bg);
  transition:background .28s ease,color .28s ease;
}
body::before{
  content:"";
  position:fixed;
  inset:0;
  z-index:0;
  pointer-events:none;
  background:var(--ambient);
  background-size:var(--ambient-size);
  opacity:var(--ambient-opacity);
  animation:ambient-drift 26s linear infinite;
}
body::after{
  content:"";
  position:fixed;
  inset:-18% 0 0;
  z-index:0;
  pointer-events:none;
  background:radial-gradient(circle at 50% 100%,rgba(255,255,255,.1),transparent 24%);
  opacity:.16;
  animation:theme-drift 18s linear infinite;
}
body > header,body > .nodes,body > .bottom{position:relative;z-index:1}
@keyframes ambient-drift{
  from{background-position:0 0,0 0,0 0,0 0}
  to{background-position:0 -210px,74px -260px,38px -170px,0 0}
}
@keyframes theme-drift{from{transform:translateY(0)}to{transform:translateY(-48px)}}
body:has(#theme-dark:checked)::before{animation-duration:34s}
body:has(#theme-ocean:checked)::before{animation-duration:13s}
body:has(#theme-tokyo:checked)::before{animation-duration:20s}

.num{font-variant-numeric:tabular-nums}
.dot{width:8px;height:8px;vertical-align:1px;box-shadow:0 0 0 3px rgba(255,255,255,.03)}
.dot.ok{box-shadow:0 0 12px color-mix(in srgb,var(--ok) 55%,transparent)}
.dot.warn{box-shadow:0 0 12px color-mix(in srgb,var(--warn) 42%,transparent)}
.dot.bad{box-shadow:0 0 12px color-mix(in srgb,var(--bad) 46%,transparent)}

header{
  gap:12px;
  padding:0 10px;
  border:1px solid var(--line);
  border-radius:8px;
  background:var(--chrome);
  box-shadow:var(--shadow);
  backdrop-filter:blur(14px);
}
header h1{font-size:16px;font-weight:750;letter-spacing:.35px;color:var(--fg);text-shadow:0 0 16px var(--accent-soft)}
header .sub{font-family:var(--mono);font-size:11px;letter-spacing:.02em}
header a{
  border-radius:999px;
  padding:3px 10px;
  background:var(--surface2);
  transition:border-color .18s ease,color .18s ease,background .18s ease;
}
header a:hover{color:var(--accent-hi);border-color:var(--accent);background:var(--accent-soft)}
header .clock{color:var(--accent-hi);font-size:14px;letter-spacing:.02em}

.theme-dock{
  position:relative;
  display:flex;
  align-items:center;
  gap:3px;
  padding:2px;
  border:1px solid var(--line);
  border-radius:999px;
  background:rgba(0,0,0,.18);
}
.theme-dock input{
  position:absolute;
  width:1px;
  height:1px;
  opacity:0;
  pointer-events:none;
}
.theme-dock label{
  display:flex;
  align-items:center;
  gap:5px;
  min-height:22px;
  padding:2px 8px;
  border-radius:999px;
  color:var(--dim);
  font-size:11px;
  font-weight:700;
  cursor:pointer;
  transition:background .18s ease,color .18s ease,box-shadow .18s ease;
}
.theme-dock label::before{
  content:"";
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--accent);
  box-shadow:0 0 8px var(--accent-soft);
}
#theme-dark + label::before{background:linear-gradient(135deg,#66d9e8,#f4c76a)}
#theme-ocean + label::before{background:linear-gradient(135deg,#54e7d4,#ffd166)}
#theme-tokyo + label::before{background:linear-gradient(135deg,#ff78d8,#55e6ff)}
.theme-dock input:checked + label{color:var(--fg);background:var(--accent-soft);box-shadow:inset 0 0 0 1px var(--line)}
.theme-dock input:focus-visible + label{outline:2px solid var(--accent);outline-offset:2px}

.nodes,.bottom{gap:10px}
.node,.panel{
  position:relative;
  overflow:hidden;
  background:var(--surface);
  border-color:var(--line);
  border-radius:8px;
  box-shadow:var(--shadow);
  backdrop-filter:blur(12px);
}
.node::before,.panel::before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:linear-gradient(180deg,var(--shine),transparent 42%);
}
.node > *,.panel > *{position:relative;z-index:1}
